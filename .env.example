# Copy to .env. Environment variables supplied by your shell take precedence.
PORT=3000
# Relative directories are resolved from the project directory.
DATA_DIR=./data
# Optional directory for existing PDF / Markdown documents.
# SOURCE_DIR=./sources
# Optional initial model; a saved selection takes precedence.
# PI_MODEL=gpt-5.5
# Optional override for the project-pinned Codex CLI used by voice features.
# CODEX_BIN=codex
# Set to 0 to disable opening the browser from the launcher.
OPEN_BROWSER=1
